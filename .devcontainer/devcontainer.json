{
  "name": "youth-policy-parser",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "youth-policy-parser/streamlit_app.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff"]
    }
  },
  "updateContentCommand": "pip3 install --user -r youth-policy-parser/requirements.txt && echo '✅ 패키지 설치 완료'",
  "postAttachCommand": {
    "server": "streamlit run youth-policy-parser/streamlit_app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": { "label": "Application", "onAutoForward": "openPreview" }
  },
  "forwardPorts": [8501]
}
