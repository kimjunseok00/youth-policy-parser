# 익명 통계 저장을 켜려면 이 파일을 secrets.toml로 복사해 값을 채운다 (secrets.toml은 커밋하지 않음).
# Streamlit Cloud에서는 앱 설정 → Secrets에 같은 내용을 붙여 넣는다.
# 이 블록이 없으면 통계 수집은 꺼진 상태로 동작한다.

[telemetry]
supabase_url = "https://<프로젝트 ID>.supabase.co"
insert_key = "sb_publishable_..."   # 쓰기 전용 (events 테이블에 insert만 허용)
read_key = "sb_secret_..."          # 리포트 읽기용. 절대 공개 저장소에 올리지 않는다
table = "events"
