// ============================================================================
// 청년정책 자격요건 DSL 문법 (v0.1 초안)
//
// 이 파일이 곧 BNF 설계 문서다. 규칙 하나가 "정책 조건 유형" 하나에 대응한다.
//   연령     : age(19..34), age(19..34, military=72), born(1986-01-01..2008-12-31)
//   거주     : region("부산광역시"), region("부산광역시", "해운대구")
//   기간     : residence_months >= 12
//   소득     : income_pct(household) <= 150, income(personal) <= 2910000
//   학력     : education in ["대학재학", "대학휴학"]
//   취업상태 : employment in ["미취업", "구직중"]
//   중복수혜 : receiving("국민취업지원제도")   (보통 NOT과 함께 씀)
//   기타     : manual("부모님과 별도 거주하는 무주택 청년")  → 항상 '확인 필요'
//
// 조합: AND, OR, NOT, 괄호. 우선순위는 NOT > AND > OR (일반 논리식과 동일).
// ============================================================================

?start: expr

// ---- 논리 조합 ------------------------------------------------------------
// '?'가 붙은 규칙은 자식이 하나뿐이면 트리에서 생략된다 (불필요한 중첩 제거).
?expr: or_expr

?or_expr: and_expr ("OR" and_expr)+   -> or_
        | and_expr

?and_expr: not_expr ("AND" not_expr)+ -> and_
         | not_expr

?not_expr: "NOT" not_expr             -> not_
         | atom

?atom: "(" expr ")"
     | predicate

// ---- 조건(술어) 8종 ------------------------------------------------------
?predicate: age
          | born
          | region
          | residence
          | income_pct
          | income_abs
          | in_set
          | receiving
          | manual

// 연령: 판정 기준일 기준 만 나이. 한쪽 경계는 생략 가능 → age(..39), age(19..)
// military=N : "군 복무 기간만큼 연령 상한 연장(최대 N개월)" → age(19..34, military=72)
age: "age" "(" [INT] ".." [INT] ["," "military" "=" INT] ")"

// 연령(출생일 범위): 공고가 "1986.1.1.~2008.12.31. 출생"처럼 생년으로 정할 때
born: "born" "(" [DATE] ".." [DATE] ")"

// 거주지: 시·도, 선택적으로 시·군·구
region: "region" "(" ESCAPED_STRING ["," ESCAPED_STRING] ")"

// 거주 기간(개월): 현 주소 전입일부터 판정 기준일까지
residence: "residence_months" COMP INT

// 소득: 기준중위소득 대비 % 또는 월 금액(원). 본인(personal) / 가구(household)
income_pct: "income_pct" "(" SCOPE ")" COMP INT
income_abs: "income" "(" SCOPE ")" COMP INT

// 학력·취업상태: 허용되는 값 목록
in_set: SET_FIELD "in" "[" ESCAPED_STRING ("," ESCAPED_STRING)* "]"

// 중복수혜: 현재 해당 지원을 받고 있는가
receiving: "receiving" "(" ESCAPED_STRING ")"

// 기타: 자동 판정할 수 없는 조건. 원문을 그대로 담아 '확인 필요'로 보낸다.
manual: "manual" "(" ESCAPED_STRING ")"

// ---- 토큰 -----------------------------------------------------------------
SCOPE: "personal" | "household"
SET_FIELD: "education" | "employment"
COMP: "<=" | ">=" | "==" | "<" | ">"
DATE: /\d{4}-\d{2}-\d{2}/

%import common.INT
%import common.ESCAPED_STRING
%import common.WS
%ignore WS

// '#' 뒤는 주석 (데이터 파일에 메모를 남길 수 있게)
COMMENT: /#[^\n]*/
%ignore COMMENT
